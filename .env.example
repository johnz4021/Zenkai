# Copy to `.env` at the repo root. Auto-loaded by server/src/cli.ts, so every
# entry point (app, session, generate) sees it — and the app passes its own
# environment to the sessions and generators it spawns.
#
# A shell export still wins: values already set in the environment are never
# overwritten by this file.
#
# `.env` is gitignored. Never commit real keys.

# --- Voice (optional) ---------------------------------------------------
# Without this the interviewer still runs, text-only: it reads your trace,
# answers spec questions, applies pressure, and replies in the chat panel.
# What you lose is TTS (hearing it) and STT (it hearing you). The session
# header will read "voice: off (no API key)".
#
# Voice enforces a hard per-session USD cap and degrades to text at 100%
# rather than muting silently — see server/src/voice.ts.
ELEVENLABS_API_KEY=

# --- Generation / judging (optional) ------------------------------------
# When set, spec inference, the intake clarifier, round naming, and the judge
# use the Anthropic API directly. Without it they shell out to `claude -p`,
# which needs the Claude CLI installed and authenticated.
ANTHROPIC_API_KEY=

# --- Per-session overrides (rarely needed) ------------------------------
# IP_VOICE=0        run a session with voice off even when a key is present
# IP_INTERVIEWER=0  run a session with no interviewer at all
# IP_USER_ID=u1     which gap-graph profile this session writes to

# --- Beta (zenkai.run) — ALL optional; unset = local dev, byte-identical -
# Browser-facing origins. The app hands these to the browser (session links,
# back-to-plan); local default is http://localhost:3300 / :3200.
# IP_PUBLIC_APP_URL=https://zenkai.run
# IP_PUBLIC_SESSION_URL=https://session.zenkai.run
#
# Bind the APP server to loopback so the tunnel is its only ingress. Do NOT
# add a bind for the session server: the container's trace WebSocket dials
# host.docker.internal (the docker gateway IP), which loopback would break.
# IP_APP_BIND=127.0.0.1
#
# Supabase (auth + record mirror). Set all three or none — partial config
# refuses to boot. Unset = auth OFF (local dev).
# IP_SUPABASE_URL=https://<project>.supabase.co
# IP_SUPABASE_ANON_KEY=            # client login only; safe in the browser
# IP_SUPABASE_SERVICE_KEY=         # server-only; never reaches client/children
# IP_AUTH_ADMIN_EMAILS=you@example.com
#
# Beta caps (unset = unlimited, today's behavior).
# IP_MAX_CONCURRENT_BUILDS=1       # across reps AND queue generation
# IP_MAX_REPS_PER_USER_DAY=3
# IP_MAX_PENDING_REPS_PER_USER=4
#
# Retention (unset = reaper off; unconsumed work is NEVER age-reaped).
# IP_RETENTION_DAYS=14
# IP_REAP_NODE_MODULES=1

# --- Multi-session (VPS beta; unset = single-session local dev) ----------
# IP_MULTI_SESSION=1               # registry + router + dynamic ports
# IP_MAX_CONCURRENT_SESSIONS=2     # live rooms at once (~1GB RAM each)
# IP_MAX_SESSIONS_PER_USER=1       # admins bypass

# --- Willingness-to-pay gate (paywall.ts) ---------------------------------
# THIS ONE REALLY DENIES. Past the free allowance a user is shown a price and
# does not get that round until they answer; "Maybe later" means no round.
# Unset = OFF (local dev, byte-identical) and is also the KILL SWITCH: unset
# it and `sudo systemctl restart zenkai-app` (~10s; KillMode=process means
# live rounds survive the restart).
#
# LEAVING THIS UNSET IS WHAT PROTECTS YOUR DEV BOX. The admin exemption does
# NOT cover you locally: if your .env configures Supabase but leaves
# IP_AUTH_ADMIN_EMAILS at the placeholder above, you sign in as a non-admin on
# your own machine and arming this really will gate you.
# Everyone in IP_AUTH_ADMIN_EMAILS is exempt, not just the first address — add
# a second admin and they silently stop being measurable.
#
# IP_PAYWALL_GATE=1                # the on switch; nothing else arms it
# IP_PAYWALL_PRICE_USD=39          # integer dollars, shown as "$39/mo"
# IP_PAYWALL_FREE_ROUNDS=3         # session launches before the gate
# IP_PAYWALL_FREE_PLANS=3          # targets before the gate (a guardrail)
#   0 IS HONORED for both (zeroOr, not intOr) — "gate immediately", which is
#   how you exercise the flow at all. Garbage and empty take the default.
# IP_PAYWALL_PAID_ROUNDS=4         # rounds a SUBSCRIBER gets per billing period
#
# TWO MODES, and the difference is whether the Stripe block below is filled in.
#
#   MEASUREMENT (gate armed, STRIPE_* unset) — the beta setting. The gate
#   fires, shows the price, and Subscribe reveals that the round is free for
#   the beta, then asks whether to email them when paid plans open. Nobody is
#   charged and nobody is blocked: pressing Subscribe is itself the grant, so
#   they get the round either way. Records the funnel to paywall.jsonl:
#     gated → would_pay → would_pay_confirmed | notify_declined
#   The drop between would_pay (free, cheap talk) and would_pay_confirmed
#   (agreeing to be emailed, costs something) IS the measurement — the gap is
#   the size of the cheap-talk problem, measured rather than assumed. The
#   optional "what would you expect to pay" answer rides on the last row.
#
#   CHARGING (gate armed, STRIPE_* set) — Subscribe goes to real hosted
#   Checkout and the money is real. One env change apart; nothing else moves.
#
# Counting `gated` rows: the SERVER writes one per refusal (it carries
# `reason`) and the CLIENT writes one when the card actually opens (no
# `reason`). Filter on that or you double-count.
#
# No card details ever touch this origin in either mode — Checkout is hosted.

# --- Stripe billing (billing.ts) ------------------------------------------
# All three together or none — a half-configured box would render a Subscribe
# button it cannot honour, which is worse than having no button. Unset =
# billing OFF: the gate still works, manual comps still work, there is just
# nothing to buy.
#
# USE A RESTRICTED KEY (rk_), not a secret key (sk_). Least privilege: write on
# Checkout Sessions, Customers and Billing Portal Sessions; read on
# Subscriptions and Prices. A leaked rk_ can do far less than a leaked sk_.
#
# These are secrets. child-env.ts drops them for every child kind, so no
# session and no agentic `claude -p` generator ever sees them — that list is a
# DENYLIST, so anything added here must be named there too.
#
# No Stripe account? `npm i -g @stripe/cli && stripe sandbox create` issues
# working test keys with no registration.
# STRIPE_API_KEY=rk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...  # from `stripe listen` or the Dashboard
# STRIPE_PRICE_ID=price_...        # one Product per plan; Prices are variants
#
# The price the gate SHOWS is read from STRIPE_PRICE_ID at boot and overrides
# IP_PAYWALL_PRICE_USD, so the two cannot drift apart.
#
# TAX: charging US or EU customers needs Stripe Tax AND an active
# registration. Setting automatic_tax alone collects nothing and returns no
# error — this integration deliberately does not enable it.

# --- PostHog analytics (posthog.ts) ---------------------------------------
# Key alone is enough; host defaults to https://us.i.posthog.com. Unset =
# analytics OFF: no vendor script served, no init rendered, no server event
# captured — the box is byte-identical to pre-analytics behavior.
#
# USE THE PROJECT KEY (phc_), never a personal API key (phx_). The project
# key is public by design — it ships to every browser, like the Supabase anon
# key — which is also why it lives in child-env.ts GENERATOR_DROP (noise
# reduction), not ALWAYS_DROP (secret custody). A phx_ key here refuses to
# boot: that one IS a secret, and this value reaches every page.
#
# What gets captured: funnels (round_launched/ended/crashed/abandoned,
# build_*, gate_*), browser exceptions, session replay. Identity is the
# Supabase user id ONLY — email and the paywall free-text answer stay in the
# local JSONL ledgers, which remain authoritative (PostHog is a mirror, like
# db.ts). The bundle is vendored from node_modules at a neutral path;
# ad-blocked users simply produce no data, and nothing breaks.
# IP_POSTHOG_KEY=phc_...
# IP_POSTHOG_HOST=https://us.i.posthog.com
#
# Session replay records the app and the round CHROME; the round's interior
# (IDE iframe, editor, transcript, test output) is BLOCKED by default —
# rrweb serializes DOM mutations on the main thread and a VS Code workbench
# is the heaviest mutation source there is, on the page that also runs the
# timer, voice and the trace WS. Flip only after measuring typing latency
# with it on, and fix the round page's "not observed" copy to match.
# IP_POSTHOG_REPLAY_ROUND=1

# --- Post-signup welcome email (welcome.ts, mailer.ts) --------------------
# Unset = the sweep refuses to run and says so; nothing else changes. Sends
# ~30 minutes after signup, driven by ops/systemd/zenkai-welcome.timer.
#
# Setup, once:
#   1. psql/SQL editor: run ops/welcome-emails.sql (the dedupe table).
#   2. Google account (2FA required) → Security → App passwords → generate one
#      for "Mail". Paste it here; spaces are stripped, so the four-group form
#      Google shows you is fine verbatim.
#   3. npx tsx server/src/cli.ts welcome-sweep --check     (proves SMTP auth)
#   4. npx tsx server/src/cli.ts welcome-sweep --dry-run   (proves the window)
#
# IP_GMAIL_APP_PASSWORD is in child-env.ts ALWAYS_DROP, alongside the Supabase
# service key and the Stripe pair: it does not read mail, it SENDS as you, so
# a generator's agentic run must never see it.
#
# IP_WELCOME_FROM sets the display name only — Gmail rewrites any From that
# is not the authenticated account or a verified alias. IP_WELCOME_REPLY_TO
# is optional; without it replies go to IP_GMAIL_USER.
# IP_GMAIL_USER=you@gmail.com
# IP_GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# IP_WELCOME_FROM=John from Zenkai <you@gmail.com>
# IP_WELCOME_REPLY_TO=you@gmail.com
#
# The email body itself is templates/welcome-email.md (git-tracked, plain
# text, {{FIRST_NAME}} / {{EMAIL}}). An unsubstituted placeholder is a hard
# error, never a mailed "Hey {{FIRST_NAME}},".
