# Copy to `.env` at the repo root. Auto-loaded by server/src/cli.ts, so every
# entry point (app, session, generate) sees it — and the app passes its own
# environment to the sessions and generators it spawns.
#
# A shell export still wins: values already set in the environment are never
# overwritten by this file.
#
# `.env` is gitignored. Never commit real keys.

# --- Voice (optional) ---------------------------------------------------
# Without this the interviewer still runs, text-only: it reads your trace,
# answers spec questions, applies pressure, and replies in the chat panel.
# What you lose is TTS (hearing it) and STT (it hearing you). The session
# header will read "voice: off (no API key)".
#
# Voice enforces a hard per-session USD cap and degrades to text at 100%
# rather than muting silently — see server/src/voice.ts.
ELEVENLABS_API_KEY=

# --- Generation / judging (optional) ------------------------------------
# When set, spec inference, the intake clarifier, round naming, and the judge
# use the Anthropic API directly. Without it they shell out to `claude -p`,
# which needs the Claude CLI installed and authenticated.
ANTHROPIC_API_KEY=

# --- Per-session overrides (rarely needed) ------------------------------
# IP_VOICE=0        run a session with voice off even when a key is present
# IP_INTERVIEWER=0  run a session with no interviewer at all
# IP_USER_ID=u1     which gap-graph profile this session writes to
