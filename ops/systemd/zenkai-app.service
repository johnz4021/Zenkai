[Unit]
Description=Zenkai beta app (home app + session router)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
User=zenkai
WorkingDirectory=/home/zenkai/Zenkai
# Secrets come from a ROOT-owned file the zenkai user cannot read off disk,
# injected by systemd — NOT a repo-root .env (which a generator or test child
# running as zenkai could read directly, defeating child-env.ts scrubbing).
# REQUIRED (no leading '-'): a missing file FAILS the unit rather than booting
# with auth silently OFF (no Supabase config = every request resolves to local
# admin). cli.ts still reads a repo-root .env in local dev; the box has none.
EnvironmentFile=/etc/zenkai/env
#
# node --import, NOT `npx tsx`. npx and the tsx bin are wrappers that spawn the
# real server as a CHILD, so systemd's MainPID was the wrapper — and with
# KillMode=process below it killed only that, orphaning the actual node server.
# The orphan kept port 3300, the replacement could not bind, and the unit still
# reported active: every `systemctl restart` since provisioning was a silent
# no-op serving hours-old code. Found 2026-08-12 when a deployed CSS fix never
# appeared. This form makes node itself the MainPID, so the signal lands on it.
ExecStart=/usr/bin/node --import tsx server/src/cli.ts app
Restart=always
RestartSec=3
# Sessions are DETACHED children by design (they survive app restarts);
# without this, systemd would kill every live interview on a unit restart.
# Safe only because ExecStart above is the server itself — with a wrapper,
# this is what spared the wrong process.
KillMode=process

[Install]
WantedBy=multi-user.target
