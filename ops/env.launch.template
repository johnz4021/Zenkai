# Zenkai LAUNCH env — fill the <> values, then:
#   scp ops/env.launch.template zenkai@<box-ip>:Zenkai/.env
#
# Sized for a public launch on a CPX31 (4 vCPU AMD / 8GB / 160GB, Ashburn),
# not the ten-person beta the first draft assumed. Differences from that
# draft are called out inline.

# --- keys -----------------------------------------------------------------
ANTHROPIC_API_KEY=<sk-ant-...>
ELEVENLABS_API_KEY=<voice; omit and sessions run text-only>

# --- public identity ------------------------------------------------------
IP_PUBLIC_APP_URL=https://zenkai.run
IP_PUBLIC_SESSION_URL=https://session.zenkai.run
IP_APP_BIND=127.0.0.1

# --- auth (Supabase) ------------------------------------------------------
IP_SUPABASE_URL=https://<project-ref>.supabase.co
IP_SUPABASE_ANON_KEY=<anon key — safe in the browser>
IP_SUPABASE_SERVICE_KEY=<service role key — server only, reaches NO child process>
IP_AUTH_ADMIN_EMAILS=zhang4021@gmail.com
# IP_SUPABASE_JWT_SECRET=   # only for legacy HS256 projects; new ones use JWKS

# --- concurrency ----------------------------------------------------------
IP_MULTI_SESSION=1
# 4 live rooms on 8GB. Measured: idle container ~29MB; active rooms (extension
# host + language servers + test runs) are the real consumers. Watch
# `docker stats` on the first busy evening before going higher.
IP_MAX_CONCURRENT_SESSIONS=4
IP_MAX_SESSIONS_PER_USER=1

# --- generation throughput + spend ----------------------------------------
# RAISED FROM 1 for launch. At 1, builds serialize globally: five people
# arriving in an hour means the fifth waits ~25 minutes seeing "someone
# else's round is generating." At 2 they mostly don't collide, and 2
# concurrent opus runs still leave CPU for live rooms on 4 vCPU.
#
# SPEND CEILING, READ THIS: each build is a ~5-minute agentic opus run. Two
# concurrent builds is a theoretical ~576 builds/day. Nothing in the product
# caps global daily spend — the real throttles are this number, the per-user
# caps below, and Google's 100-test-user ceiling. Watch the Anthropic console
# for the first few days; if traffic is real, a global daily build cap is a
# small follow-up.
IP_MAX_CONCURRENT_BUILDS=2
IP_MAX_REPS_PER_USER_DAY=3
IP_MAX_PENDING_REPS_PER_USER=4

# --- retention ------------------------------------------------------------
# node_modules reaped once a round is graded (60MB -> ~2MB); used reps slimmed
# after 14 days; unconsumed work is NEVER age-reaped.
IP_RETENTION_DAYS=14
IP_REAP_NODE_MODULES=1

# --- willingness-to-pay gate (paywall.ts) ---------------------------------
# THIS ONE REALLY DENIES. Past the free allowance a user is shown a price and
# does not get that round unless they press Subscribe. No card details are
# collected anywhere — the measurement is the click, and the reveal that
# payments are not switched on yet is immediate and in place.
#
# KILL SWITCH: comment IP_PAYWALL_GATE out and
#   sudo systemctl restart zenkai-app
# ~10 seconds, and KillMode=process means nobody's live round is touched.
# One bad report from a beta user turns the whole thing off, no deploy.
#
# You are exempt (admin), so you will never see it on the live box. To eyeball
# the flow run this in the devtools console:
#   showPaywallGate({price_usd:39, reason:'rounds', used:3, free:3})
#
# 3 rounds is the experiment; 3 plans is a guardrail, not the measurement (a
# plan costs ~$1 against a round's $1.35-$4.39, and it is the on-ramp). Read
# the result per docs/beta-runbook.md 6a — and read it deduped BY PERSON.
IP_PAYWALL_GATE=1
IP_PAYWALL_PRICE_USD=39
IP_PAYWALL_FREE_ROUNDS=3
IP_PAYWALL_FREE_PLANS=3
